{
  // Konfiguracja wdrożenia na Cloudflare Workers ze statycznymi zasobami.
  //
  // Bez tego pliku `wrangler deploy` uruchamiał kreator, próbował wysłać cały
  // katalog projektu razem z `node_modules` i przerywał się na pliku workerd
  // ważącym 144 MiB (limit pojedynczego zasobu to 25 MiB). Lista wykluczeń
  // jest w `.assetsignore`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nieruchomo-ci-chodkiewicza-2",
  "main": "worker.js",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Worker musi zobaczyć żądanie przed warstwą statyczną: podmienia w
    // stronie głównej adresy bezwzględne na adres bieżącego hosta, generuje
    // robots.txt oraz mapę strony, a adresy sekcji (/kontakt, /oferta)
    // przekłada na kotwice strony głównej. Ta ostatnia funkcja wymaga wzorca
    // ogólnego — lista konkretnych tras nie obejmie adresu, którego nikt
    // wcześniej nie przewidział.
    //
    // Wyjątkiem jest /assets/* — zdjęcia, czcionki i style idą prosto z
    // warstwy statycznej. Worker nie ma tam nic do roboty, a każde jego
    // uruchomienie to koszt i kilka milisekund opóźnienia na zasób.
    "run_worker_first": ["/*", "!/assets/*"],
    // Nieistniejący adres dostaje stronę 404 w szacie graficznej serwisu,
    // z odnośnikami do obu ofert — zamiast surowego komunikatu przeglądarki.
    "not_found_handling": "404-page"
  }
}
