# Copy to `.dev.vars` (gitignored). Loaded automatically by `wrangler dev`
# to provide secrets to the Worker during local development.
#
# Runtime-only values. ADMIN_EMAIL is used as the server-side authorization
# allowlist. ADMIN_PASSWORD stays only in `.env` for the local seed script.
BETTER_AUTH_SECRET="generate-a-long-random-secret"
APP_ORIGIN="http://localhost:8787"
ADMIN_EMAIL="admin@example.com"
PUBLIC_SITE_ORIGIN="http://localhost:3000"
