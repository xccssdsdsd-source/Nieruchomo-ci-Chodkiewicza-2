# Copy to `.env` (gitignored). Used by drizzle-kit (migrations) and
# scripts/seed-admin.ts — NOT by the Worker at runtime (the Worker reaches
# Postgres through the Hyperdrive binding, not this URL).

# Neon Postgres connection string for THIS project's branch.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin account created by `npm run seed:admin`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-locally-with-generated-16-plus-characters"

# Better Auth signing secret — must match the Worker's BETTER_AUTH_SECRET.
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-long-random-secret"
